# Solo desarrollo. Generar valores locales con npm exec tsx scripts/configure.ts.
APP_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://intranet:development-only@localhost:5432/intranet
POSTGRES_USER=intranet
POSTGRES_PASSWORD=development-only
POSTGRES_DB=intranet
REDIS_URL=redis://localhost:6379
# 32 bytes hex, claves independientes; nunca reutilizar en producción.
ENCRYPTION_KEY=
AUDIT_KEY=
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=intranet
S3_ACCESS_KEY=development
S3_SECRET_KEY=
MINIO_ROOT_USER=development
MINIO_ROOT_PASSWORD=
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=intranet@example.invalid
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MUNICIPALITY_NAME=Municipalidad de Villa del Roble (ficticia)
SESSION_IDLE_MINUTES=30
REQUEST_BUSINESS_DAYS=15
MAX_UPLOAD_MB=20
# Activar seed solo en entorno de desarrollo; se generan claves aleatorias locales.
DEMO_PASSWORD=
DEMO_TOTP_SECRET=
OIDC_ENABLED=false
WEB_PUSH_ENABLED=false
